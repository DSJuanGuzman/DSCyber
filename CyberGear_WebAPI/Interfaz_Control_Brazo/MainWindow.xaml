<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interfaz_Control_Brazo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sección de Inicialización -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,10">Inicialización</TextBlock>

                <!-- Iniciar Servicio -->
                <Button x:Name="Iniciar_Button" Content="Iniciar Servicio" Margin="0,0,0,10" Click="Iniciar_Button_Click" />

                <!-- ID Motor -->
                <TextBlock Text="ID del Motor" Margin="0,0,0,5" />
                <StackPanel x:Name="MotorStackPanel">
                    <TextBox x:Name="Id_1" TextWrapping="Wrap" Margin="0,0,0,10" />
                </StackPanel>
                <Button x:Name="AgregarMotor_Button" Content="Agregar Motor" Click="AgregarMotor_Button_Click" />

                <!-- Configuración -->
                <TextBlock Text="Modo de Configuración" Margin="15,10,0,5" />
                <ComboBox x:Name="Configuration_ComboBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="0. Parallel" />
                    <ComboBoxItem Content="1. Inverted" />
                    <ComboBoxItem Content="2. Combined" />
                </ComboBox>

                <!-- Crear Joint -->
                <Button x:Name="Create_Button" Content="Crear Joint" Margin="0,0,0,10" Click="Create_Button_Click"/>
            </StackPanel>
        </Border>

        <!-- Sección de Control de Operación -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="10" Padding="10">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,10">Control de Operación</TextBlock>

                <!-- Articulación Actual -->
                <TextBlock Text="Articulación Actual" Margin="0,0,0,5" />
                <ComboBox x:Name="CurrentJoint_ComboBox" HorizontalAlignment="Left" Height="22" Width="150" Margin="0,0,0,10" DropDownOpened="CurrentJoint_ComboBox_DropDownOpened" />

                <!-- Posición -->
                <TextBlock Text="Posición" Margin="0,0,0,5" />
                <TextBox x:Name="Position_Textbox" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Velocidad -->
                <TextBlock Text="Velocidad" Margin="0,0,0,5" />
                <TextBox x:Name="Speed_Textbox" TextWrapping="Wrap" Margin="0,0,0,10" />

               

                <!-- Enviar Comando -->
                <Button x:Name="Send_Command" Content="Enviar Comando" Margin="0,0,0,10" />
                <!-- Botones + y - -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" Height="63">
                    <Button x:Name="MoveBackward_Button" Content="-" FontSize="20" Width="162" Height="30" Margin="10" Click="MoveBackward_Button_Click" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="MoveForward_Button" Content="+" FontSize="20" Width="162" Height="30" Margin="10" Click="MoveForward_Button_Click" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- Modo -->
                <TextBlock Text="Modo" Margin="0,0,0,5" />
                <TextBox x:Name="Modo_TextBox" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Establecer Modo -->
                <Button x:Name="SetMode_Button" Content="Establecer Modo" Margin="0,0,0,10" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
